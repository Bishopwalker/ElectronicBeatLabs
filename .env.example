# Electromagnetic Beat Lab - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_DB=ebl_db
POSTGRES_USER=ebl_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://ebl_user:change_me_in_production@postgres:5432/ebl_db

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://default:change_me_in_production@redis:6379/0

# ==========================================
# APPLICATION SECRETS
# ==========================================
SECRET_KEY=generate_random_secret_key_here
JWT_SECRET=generate_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==========================================
# ENVIRONMENT
# ==========================================
NODE_ENV=production
PYTHON_ENV=production
DEBUG=false

# ==========================================
# CORS CONFIGURATION
# ==========================================
ALLOWED_ORIGINS=https://electromagnetic-beat-lab.com,https://www.electromagnetic-beat-lab.com

# ==========================================
# STRIPE PAYMENT (Optional)
# ==========================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==========================================
# AWS COGNITO (Optional - if using)
# ==========================================
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@electromagnetic-beat-lab.com

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# ==========================================
# AUDIO ENGINE
# ==========================================
SAMPLE_RATE=48000
BUFFER_SIZE=512
MAX_FREQUENCY=199

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=120