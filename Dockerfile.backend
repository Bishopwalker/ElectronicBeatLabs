# Electromagnetic Beat Lab - Backend Production Build
# FastAPI + Python 3.11 with WORKING PyAudio

FROM python:3.11-slim AS builder

WORKDIR /app

# Install ALL build dependencies including C compiler for numpy
RUN apt-get update && apt-get install -y --no-install-recommends \
 gcc \
 g++ \
 build-essential \
 portaudio19-dev \
 python3-dev \
 libffi-dev \
 libasound2-dev \
 && rm -rf /var/lib/apt/lists/*

# Copy and install Python requirements
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir --user -r requirements.txt

# ==========================================
# Production Runtime
# ==========================================
FROM python:3.11-slim AS production

WORKDIR /app

# Install ALL runtime dependencies (CRITICAL FIX)
RUN apt-get update && apt-get install -y --no-install-recommends \
 portaudio19-dev \
 libasound2 \
 libportaudio2 \
 libportaudiocpp0 \
 curl \
 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

# Create non-root user
RUN groupadd -r ebl && useradd -r -g ebl -u 1001 ebl

# Copy Python packages AND shared libraries
COPY --from=builder /root/.local /home/ebl/.local
COPY --from=builder /usr/lib/x86_64-linux-gnu/libportaudio* /usr/lib/x86_64-linux-gnu/

# Copy backend application
COPY --chown=ebl:ebl backend/ ./

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/uploads \
 && chown -R ebl:ebl /app

USER ebl

ENV PATH=/home/ebl/.local/bin:$PATH
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHON_ENV=production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
CMD curl -f http://localhost:8000/health || exit 1

LABEL maintainer="bishop8-group" \
 version="1.0.0" \
 description="EBL Backend - FastAPI + Python 3.11 with PyAudio"

# Use single worker for WebSocket compatibility
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--ws-ping-interval", "20", "--ws-ping-timeout", "20"]