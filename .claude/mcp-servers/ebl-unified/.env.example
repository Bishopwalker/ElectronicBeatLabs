# EBL Unified MCP Server - Environment Configuration

# ============================================
# Model API Keys
# ============================================

# Anthropic Claude (Primary Model)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (Codex/GPT-4 - when you have credits)
OPENAI_API_KEY=sk-your-openai-key-here

# Custom Model Provider (OpenRouter, etc.)
CUSTOM_MODEL_API_KEY=your-custom-api-key

# ============================================
# RAG Configuration (from Agent 3)
# ============================================

# Vector Storage Provider: "chroma" (local) or "supabase" (cloud)
VECTOR_PROVIDER=chroma

# ChromaDB Settings (local)
CHROMA_PERSIST_DIR=./.claude/rag/chroma_db

# Supabase Settings (optional cloud vector storage)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=your-supabase-key

# ============================================
# Memory Configuration (from Agent 3)
# ============================================

# Memory Mode: "local" (no API key) or "cloud" (with API key)
MEM0_MODE=local

# Mem0 Cloud Settings (optional)
# MEM0_API_KEY=your-mem0-api-key
# MEM0_ORGANIZATION_ID=your-org-id
# MEM0_PROJECT_ID=your-project-id

# ============================================
# Server Configuration
# ============================================

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Project Root (where your codebase lives)
PROJECT_ROOT=C:/Users/bisho/IdeaProjects/ebl

# Max Buffer Size (10MB like codex server)
MAX_BUFFER_SIZE=10485760
