{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\bisho\\IdeaProjects\\ebl"
      ],
      "description": "File system access for EBL project"
    },
    "docker": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-docker"],
      "env": {
        "DOCKER_HOST": "npipe:////./pipe/docker_engine"
      },
      "description": "Docker container management for EBL services"
    },
    "aws": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-aws"],
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1"
      },
      "description": "AWS services for EBL deployment"
    },
    "gitlab": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gitlab"],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "YOUR_TOKEN_HERE",
        "GITLAB_API_URL": "https://gitlab.com/api/v4"
      },
      "description": "GitLab integration for EBL repository"
    },
    "openapi_ebl": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-openapi",
        "http://localhost:8000/openapi.json"
      ],
      "description": "OpenAPI access to EBL backend (RAG endpoints)"
    }
  },
  "debug": false,
  "logLevel": "info"
}