# Electromagnetic Beat Lab - Development Docker Build
# Hot-reload enabled for both frontend and backend

FROM node:20-slim

WORKDIR /app

# Install Python and system dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3-pip \
    python3.11-venv \
    portaudio19-dev \
    gcc \
    g++ \
    make \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Node dependencies (force reinstall for Linux platform)
COPY package*.json ./
RUN npm ci --ignore-scripts && npm rebuild

# Create Python virtual environment (mirrors GitLab CI cache strategy)
RUN python3 -m venv backend/.venv

# Install Python dependencies in virtual environment with cache mount
COPY backend/requirements.txt ./backend/
RUN --mount=type=cache,target=/root/.cache/pip \
    backend/.venv/bin/pip install --upgrade pip && \
    backend/.venv/bin/pip install -r backend/requirements.txt

# Copy source code
COPY . .

# Expose ports
EXPOSE 5173 8000

# Development environment variables
ENV NODE_ENV=development
ENV PYTHON_ENV=development
ENV PYTHONUNBUFFERED=1
ENV PATH="/app/backend/.venv/bin:$PATH"
ENV PYTHONPATH="/app/backend:$PYTHONPATH"

# Start both frontend and backend with hot-reload (using venv python)
# Rebuild npm packages at startup to ensure Linux compatibility when using volume mounts
CMD ["sh", "-c", "(npm rebuild && npm run dev) & cd /app && /app/backend/.venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload"]