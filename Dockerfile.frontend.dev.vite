# Frontend Dockerfile - Fixed Version
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files for dependency caching
COPY package.json package-lock.json ./

# Clean install with exact versions from lock file
RUN npm ci

# Copy source files
COPY src/ ./src/
COPY public/ ./public/
COPY index.html ./
COPY vite.config.ts ./
COPY tsconfig*.json ./

# Build with proper backend URL for Docker Compose
ARG VITE_API_URL=http://backend:8000
ARG VITE_WS_URL=ws://backend:8000
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL

RUN npm run build