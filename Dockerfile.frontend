# Electromagnetic Beat Lab - Frontend Production Build
# Serves static React app via Nginx

# ==========================================
# Stage 1: Build Frontend
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files for better layer caching
COPY package*.json ./
COPY yarn.lock* ./

# Install dependencies
RUN npm ci --no-audit --prefer-offline

# Copy source files
COPY src/ ./src/
COPY public/ ./public/
COPY index.html ./
COPY vite.config.ts ./
COPY tsconfig*.json ./

# Build frontend for production
RUN npm run build

# ==========================================
# Stage 2: Nginx Production Server
# ==========================================
FROM nginx:alpine AS production

# Copy built frontend assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx config (if exists, otherwise use default)
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Expose port
EXPOSE 80

# Metadata
LABEL maintainer="bishop8-group" \
      version="1.0.0" \
      description="EBL Frontend - React + Vite + Nginx"

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
