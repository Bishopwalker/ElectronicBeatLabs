# Ensure bash scripts always use LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Python files
*.py text eol=lf

# JavaScript/TypeScript files  
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env* text eol=lf
Dockerfile* text eol=lf

# Documentation
*.md text eol=lf

# Default for all text files
* text=auto
