{
  "name": "ebl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn main:app --reload --reload-exclude '.venv/*' --host 0.0.0.0 --port 8000",
    "dev:backend:py": "python start-backend-dev.py",
    "dev:all": "concurrently --kill-others-on-fail \"npm run dev\" \"npm run dev:backend\"",
    "dev:clean": "start-dev.bat",
    "dev:stop": "stop-dev.bat",
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "preview": "vite preview",
    "backend:install": "cd backend && pip install -r requirements.txt",
    "backend:test": "cd backend && .\\.venv\\Scripts\\python.exe -m pytest",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint:sec": "eslint . -c eslint-security.config.js",
    "cucumber": "cucumber-js",
    "test:e2e": "cucumber-js --require-module ts-node/register",
    "test:all": "npm run test && npm run test:e2e",
    "test:full": "npm run test:coverage && npm run test:e2e && npm run backend:test",
    "enforce": "npm run lint:sec && npm run build:check && npm test && npm run test:e2e && npm run backend:test && npm run rag:generate",
    "rag:generate": "node scripts/generate-enforcer-rag.mjs",
    "deploy:frontend": "bash scripts/deploy-frontend.sh",
    "deploy:frontend:staging": "bash scripts/deploy-frontend.sh staging",
    "deploy:backend": "bash scripts/deploy-backend.sh",
    "deploy:backend:staging": "bash scripts/deploy-backend.sh staging",
    "deploy:all": "npm run deploy:frontend && npm run deploy:backend",
    "deploy:all:staging": "npm run deploy:frontend:staging && npm run deploy:backend:staging",
    "ts-fixer": "node src/agents/typescript-fixer/dist/runner.js start",
    "ts-fixer:scan": "node src/agents/typescript-fixer/dist/runner.js scan --fix",
    "ts-fixer:watch": "node src/agents/typescript-fixer/dist/runner.js start --verbose",
    "ts-fixer:stats": "node src/agents/typescript-fixer/dist/runner.js stats"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "keycloak-js": "^26.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
     "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "chalk": "^5.6.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "inquirer": "^12.9.4",
    "jest": "^30.1.2",
    "babel-jest": "^30.1.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.1.2",
    "jest-junit": "^16.0.0",
    "jsdom": "^26.1.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^0.25.0",
    "identity-obj-proxy": "^3.0.0"
  }
}